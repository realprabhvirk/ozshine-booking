# Copy this file to .env.local and fill in real values for local use.
# In Vercel, these are set under Project Settings → Environment Variables
# instead — for Production, Preview, AND Development.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. The site's public address (e.g. https://book.ozshine.com.au), used
# for search-engine links and the sitemap. Leave it out and Vercel's own
# production address is used automatically.
# NEXT_PUBLIC_SITE_URL=

# Optional. The staff app's address, pinged after a booking so confirmation
# texts/emails go out instantly in Live mode. Defaults to
# https://ozshine-admin.vercel.app — only set it if the staff app moves.
# NEXT_PUBLIC_ADMIN_APP_URL=
