# Copy this file to .env.local and fill in real values for local use.
# In Vercel, these are set under Project Settings → Environment Variables
# instead — for Production, Preview, AND Development.

# Required
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Optional. Leave all of these out and everything still works (messages stay
# in demo mode and automatic reminders are checked while the app is open).
# ---------------------------------------------------------------------------

# Sending key. Paste the key made in the staff app under Messages → Setup.
# Needed for Live sending: the instant send (/api/messages/flush, right after
# a booking or staff action) and the daily job (vercel.json →
# /api/cron/messages, 7am Brisbane) both use it. Production only.
# CRON_SECRET=

# Real SMS through Twilio. Only used once Messages → Setup is switched to Live.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=            # your Twilio number or alphanumeric sender ID, e.g. OzShine

# Real email through Resend. Only used once Messages → Setup is switched to Live.
# The sending domain (ozshinecarwash.com.au) must be verified in Resend → Domains.
# RESEND_API_KEY=
# RESEND_FROM=            # optional, defaults to OzShine Beenleigh <beenleigh@ozshinecarwash.com.au>
